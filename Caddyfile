# TLS in front of the API. uvicorn listens on 127.0.0.1 only, so plain HTTP never leaves the box.
# Hostname comes from SENTINEL_HOST (a DNS name or IP the Macs can reach); defaults to localhost.
# `tls internal` = Caddy's own CA, no cert files needed. Its root must be trusted on every Mac
# (DEPLOY.md step 4). Have an IT-issued cert instead? Use: tls /path/cert.pem /path/key.pem
{$SENTINEL_HOST:localhost} {
	tls internal
	request_body {
		max_size 1MB
	}
	reverse_proxy 127.0.0.1:8000
}
